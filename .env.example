# CLINCH environment — NAMES ONLY. Never commit real values (see .gitignore).
# Model provider (Qwen via Bitget-sponsored Chat Completions-compatible gateway). Server-only secret.
BITGET_QWEN_API_KEY=
# Proven sponsored gateway base URL.
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
# Proven sponsored model.
