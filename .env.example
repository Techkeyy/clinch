# CLINCH environment — NAMES ONLY. Never commit real values (see .gitignore).
# Model provider (Qwen via DashScope OpenAI-compatible API). Absent until owner provisions.
DASHSCOPE_API_KEY=
# Workspace-bound base URL, e.g. https://<workspace>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
# Exact model name resolved in P9 (owner console + credits)
QWEN_MODEL=
# Postgres connection string. Absent for local dev (P9 uses local file-backed sessions);
# Neon URL required for deployed/production use (P18).
DATABASE_URL=
# 256-bit hex pepper for anonymous session-ownership HMACs. Generate locally only.
SESSION_PEPPER=
