[Unit]
Description=CLINCH Decision Watch worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clinch
Group=clinch
WorkingDirectory=/opt/clinch/current
EnvironmentFile=/etc/clinch/watch-worker.env
Environment=NODE_ENV=production
Environment=WATCH_WORKER_ID=%H
Environment=WATCH_WORKER_BATCH_SIZE=1
ExecStart=/opt/clinch/runtime/node-v24.14.0-linux-x64/bin/node /opt/clinch/current/dist/watch-worker.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
